# homefood-server
PORT=4000
MONGO_URL=mongodb+srv://homefood_dev:0G4WGW5nZwvhwmVS@homefood.zhqlv53.mongodb.net/
DB_NAME=homefood
JWT_SECRET=replace-with-long-random-secret

# Public URL of the web app (used to build password-reset links when EXPOSE_AUTH_TOKENS_IN_API is on)
FRONTEND_URL=http://localhost:5173

# In production set to "false" so register / forgot-password never return raw tokens in JSON.
# Default: off in production, on in development.
# EXPOSE_AUTH_TOKENS_IN_API=false

# AI ordering assistant (POST /api/agent/chat). Without this key, the endpoint returns 503.
# OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini)
# AI_MODEL=gpt-4o-mini

NODE_ENV=development
